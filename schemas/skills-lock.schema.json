{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/creatorassets1-a11y/leviathan/blob/main/schemas/skills-lock.schema.json",
  "title": "Leviathan Skills Lock",
  "type": "object",
  "required": ["schemaVersion", "source", "generatedAt", "selected"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "source": { "type": "string", "const": "skills.sh" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "query": { "type": "string" },
    "policy": { "type": "string" },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source", "status", "activation"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "name": { "type": "string" },
          "source": { "type": "string" },
          "installUrl": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "installs": { "type": "integer", "minimum": 0 },
          "score": { "type": "number" },
          "reason": { "type": "string" },
          "status": { "enum": ["selected_for_review", "approved", "rejected", "disabled"] },
          "activation": { "enum": ["manual_after_review", "approved", "disabled"] },
          "hash": { "type": ["string", "null"] },
          "audit": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
